<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <com.godmotion.app.TimelineView
        android:id="@+id/timeline"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="8dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnImport" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Import" android:textSize="10sp"
            android:paddingLeft="0dp" android:paddingRight="0dp" />
        <Button android:id="@+id/btnText" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="+Text" android:textSize="10sp"
            android:paddingLeft="0dp" android:paddingRight="0dp" />
        <Button android:id="@+id/btnShape" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="+Shape" android:textSize="10sp"
            android:paddingLeft="0dp" android:paddingRight="0dp" />
        <Button android:id="@+id/btnSplit" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Split" android:textSize="10sp"
            android:paddingLeft="0dp" android:paddingRight="0dp" />
        <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Delete" android:textSize="10sp"
            android:paddingLeft="0dp" android:paddingRight="0dp" />
    </LinearLayout>
</LinearLayout>
